---
import type { CollectionEntry } from 'astro:content';

import BlogPostLayout from '@/layouts/BlogPostLayout.astro';
import { getPublishedPosts } from '@/util/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map(post => ({
    params: { slug: post.id },
    props: post,
  }));
}

type Props = CollectionEntry<'blog'>;

const published = await getPublishedPosts();

const post = Astro.props;
const idx = published.findIndex(p => p.id === post.id);

const prevPost = idx > 0 ? published[idx - 1] : published[published.length - 1];
const nextPost = idx < published.length - 1 ? published[idx + 1] : published[0];
---

<BlogPostLayout post={post} prevPost={prevPost} nextPost={nextPost} />
